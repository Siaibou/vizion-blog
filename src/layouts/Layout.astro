---
import Navigation from '../components/Navigation.astro';
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Vizion Blog</title>

        <!-- IBM Plex Sans + IBM Plex Mono : polices techniques distinctives -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

        <!-- KaTeX pour les formules mathématiques -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    </head>
    <body>
        <Navigation />

        <main class="page-main">
            <slot />
        </main>
    </body>
</html>

<style is:global>
    /* ---- Palette + design tokens ---- */
    :root {
        --bg-primary: #0d1421;
        --bg-secondary: #131c2e;
        --bg-card: #162033;
        --bg-card-hover: #1c2940;
        --bg-code-inline: #1a2436;
        --bg-code-block: #0a111d;
        --border: #243752;
        --border-strong: #2d4a73;

        --text-primary: #e5e9f0;
        --text-secondary: #aab3c1;
        --text-muted: #7a8590;

        --accent: #88c0d0;
        --accent-hover: #a8d4e2;
        --accent-warm: #ebcb8b;
        --accent-soft: rgba(136, 192, 208, 0.12);

        --font-body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'IBM Plex Mono', 'JetBrains Mono', Menlo, monospace;

        --radius: 8px;
    }

    /* ---- Base ---- */
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        background: var(--bg-primary);
        color: var(--text-primary);
        font-family: var(--font-body);
        font-size: 17px;
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .page-main {
        box-sizing: border-box;
        margin: auto;
        padding: 1rem 1.5rem 4rem;
        width: 928px;
        max-width: 100%;
    }

    /* ---- Téléphone : marges plus fines, tableaux larges défilables ---- */
    @media (max-width: 700px) {
        .page-main { padding-left: 1rem; padding-right: 1rem; }
        table { display: block; overflow-x: auto; }
    }

    /* ---- Titres ---- */
    h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-body);
        font-weight: 600;
        color: var(--text-primary);
        line-height: 1.3;
        margin-top: 2.2em;
        margin-bottom: 0.6em;
    }
    h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-top: 1.5rem;
        padding-left: 1rem;
        border-left: 4px solid var(--accent);
        letter-spacing: -0.01em;
    }
    h2 {
        font-size: 1.6rem;
        margin-top: 2.5em;
        padding-bottom: 0.3em;
        border-bottom: 1px solid var(--border);
    }
    h3 { font-size: 1.25rem; color: var(--accent-hover); }
    h4 { font-size: 1.05rem; color: var(--text-secondary); }

    /* ---- Paragraphes, listes, liens ---- */
    p { margin: 1em 0; color: var(--text-primary); }

    a {
        color: var(--accent);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
    }
    a:hover {
        color: var(--accent-hover);
        border-bottom-color: var(--accent-hover);
    }

    ul, ol { padding-left: 1.5em; margin: 1em 0; }
    li { margin: 0.4em 0; }
    li > p { margin: 0.3em 0; }

    strong { color: #f4f6fa; font-weight: 600; }
    em { color: var(--text-secondary); }

    hr {
        border: none;
        height: 1px;
        background: var(--border);
        margin: 2.5em 0;
    }

    /* ---- Code inline et blocs ---- */
    code {
        font-family: var(--font-mono);
        font-size: 0.92em;
        background: var(--bg-code-inline);
        color: var(--accent-warm);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        border: 1px solid var(--border);
    }

    pre {
        background: var(--bg-code-block);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem 1.2rem;
        overflow-x: auto;
        line-height: 1.55;
        font-size: 0.92em;
        margin: 1.5em 0;
    }
    pre code {
        background: transparent;
        border: none;
        padding: 0;
        color: var(--text-primary);
        font-size: inherit;
    }

    /* ---- Blockquotes ---- */
    blockquote {
        border-left: 3px solid var(--accent);
        background: var(--accent-soft);
        padding: 0.8em 1.2em;
        margin: 1.5em 0;
        border-radius: 0 var(--radius) var(--radius) 0;
        color: var(--text-primary);
    }
    blockquote p { margin: 0.3em 0; }

    /* ---- Tableaux : LE point critique ---- */
    table {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5em 0;
        font-size: 0.95em;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        overflow: hidden;
    }
    thead {
        background: var(--bg-secondary);
    }
    th {
        text-align: left;
        padding: 0.7em 1em;
        font-weight: 600;
        color: var(--accent);
        border-bottom: 2px solid var(--border-strong);
        font-size: 0.92em;
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }
    td {
        padding: 0.7em 1em;
        border-bottom: 1px solid var(--border);
        color: var(--text-primary);
        vertical-align: top;
    }
    tbody tr:nth-child(even) {
        background: rgba(255, 255, 255, 0.015);
    }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: var(--bg-card); }

    /* ---- Images ---- */
    img {
        max-width: 100%;
        height: auto;
        border-radius: var(--radius);
        border: 1px solid var(--border);
    }

    /* ---- Sélection ---- */
    ::selection {
        background: var(--accent);
        color: var(--bg-primary);
    }
</style>
