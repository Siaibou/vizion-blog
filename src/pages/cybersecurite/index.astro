---
import Layout from '../../layouts/Layout.astro';
---

<Layout>
    <p class="section-kicker">Section</p>
    <h1>Cybersécurité</h1>
    <p class="section-intro">Mon journal d'apprentissage de la sécurité offensive et défensive, de TryHackMe à OverTheWire.</p>

    <details open>
        <summary>Récapitulatifs Vizion (notes de cours)</summary>
        <ul class="article-list">
            <li><a href="/cybersecurite/vizion-1-reseaux">Vizion 1 — Réseaux : OSI, TCP/UDP, intermédiaires</a></li>
        </ul>
    </details>

    <details open>
        <summary>OverTheWire — Bandit</summary>
        <ul class="article-list">
            <li><a href="/cybersecurite/bandit-0">Niveau 0 → 1</a></li>
            <li><a href="/cybersecurite/bandit-1">Niveau 1 → 2</a></li>
            <li><a href="/cybersecurite/bandit-2">Niveau 2 → 3</a></li>
            <li><a href="/cybersecurite/bandit-3">Niveau 3 → 4</a></li>
            <li><a href="/cybersecurite/bandit-4">Niveau 4 → 5</a></li>
            <li><a href="/cybersecurite/bandit-5">Niveau 5 → 6</a></li>
        </ul>
    </details>

    <details>
        <summary>TryHackMe</summary>
        <ul class="article-list">
            <li><em>Aucun article publié pour l'instant.</em></li>
        </ul>
    </details>
</Layout>

<style>
    .section-kicker {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin: 1.5rem 0 0.3rem;
    }
    h1 { margin-top: 0.3rem; }
    .section-intro {
        color: var(--text-secondary);
        font-size: 1.05rem;
        margin: 0.5rem 0 2rem;
        max-width: 620px;
    }

    details {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin-bottom: 0.8rem;
        overflow: hidden;
        transition: border-color 0.2s ease;
    }
    details[open] { border-color: var(--border-strong); }

    summary {
        padding: 1rem 1.2rem;
        cursor: pointer;
        font-weight: 500;
        color: var(--text-primary);
        position: relative;
        list-style: none;
        transition: background 0.15s ease;
    }
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: var(--bg-card-hover); }

    summary::after {
        content: '+';
        position: absolute;
        right: 1.2rem;
        font-family: var(--font-mono);
        color: var(--accent);
        font-weight: 600;
    }
    details[open] summary::after { content: '−'; }

    .article-list {
        padding: 0.5rem 1.5rem 1rem;
        margin: 0;
        list-style: none;
    }
    .article-list li {
        padding: 0.6rem 0;
        border-top: 1px solid var(--border);
    }
    .article-list li:first-child { border-top: none; }
    .article-list em { color: var(--text-muted); }
</style>
