---
import Layout from '../layouts/Layout.astro';
import { bilanLicence } from '../data/licence.js';
import { bilanAutodidacte } from '../data/autodidacte.js';

const licence = bilanLicence();
const auto = bilanAutodidacte();
---

<Layout>
    <div class="hero">
        <p class="kicker">Journal de progression</p>
        <h1 class="hero-title">Vers l'<span>AI Security Engineering</span>.</h1>
        <p class="hero-sub">
            Je documente ici mon apprentissage, en deux parties : ma licence d'informatique, cours par cours,
            et ce que j'apprends en autodidacte, de la cybersécurité à l'IA.
            Les articles sont des notes que je publie pour mieux les structurer — et pour qu'on me corrige si je me trompe.
        </p>
    </div>

    <hr />

    <h2 class="sections-title">Les deux parties</h2>

    <div class="sections-grid">
        <a class="section-card" href="/licence/">
            <span class="section-tag">Cursus</span>
            <strong>Licence</strong>
            <span class="section-desc">Mes cours de licence d'informatique : la présentation de chaque cours, puis mes cours et notes de révision.</span>
            <span class="section-stat">{licence.cours} cours · {licence.contenus} contenus publiés</span>
        </a>
        <a class="section-card" href="/autodidacte/">
            <span class="section-tag">Hors cursus</span>
            <strong>Autodidacte</strong>
            <span class="section-desc">Cybersécurité, outils, projets personnels, et bientôt l'intelligence artificielle.</span>
            <span class="section-stat">{auto.themes} thèmes · {auto.contenus} contenus publiés</span>
        </a>
    </div>
</Layout>

<style>
    .hero { margin-top: 2rem; margin-bottom: 2.5rem; }

    .kicker {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.15em;
        margin: 0 0 0.5rem 0;
    }

    .hero-title {
        font-size: 2.8rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1.15;
        margin: 0 0 1rem 0;
        padding: 0;
        border: none;
    }
    .hero-title span {
        color: var(--accent);
    }

    .hero-sub {
        font-size: 1.1rem;
        color: var(--text-secondary);
        line-height: 1.65;
        max-width: 620px;
    }

    .sections-title {
        font-size: 1.1rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-muted);
        font-weight: 500;
        border: none;
        margin-top: 2.5rem;
    }

    .sections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .section-card {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.3rem 1.4rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        text-decoration: none;
        transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
        position: relative;
    }
    .section-card:hover {
        background: var(--bg-card-hover);
        border-color: var(--accent);
        transform: translateY(-2px);
    }
    .section-card .section-tag {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent);
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }
    .section-card strong {
        font-size: 1.2rem;
        color: var(--text-primary);
        font-weight: 600;
    }
    .section-card .section-desc {
        font-size: 0.95rem;
        color: var(--text-secondary);
        line-height: 1.5;
    }
    .section-card .section-stat {
        margin-top: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.78rem;
        color: var(--text-muted);
    }
</style>
