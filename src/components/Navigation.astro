---
// Deux entrées : la licence, et tout ce que j'apprends seul.
// Les articles gardent leurs adresses d'origine (/cybersecurite/..., /informatique/...),
// d'où la liste des préfixes qui allument « Autodidacte ».
const chemin = Astro.url.pathname;
const actif = chemin.startsWith('/licence')
    ? 'licence'
    : ['/autodidacte', '/cybersecurite/', '/informatique/'].some((p) => chemin.startsWith(p))
        ? 'autodidacte'
        : '';
---
<nav class="navbar">
    <div class="nav-content">
        <a href="/" class="site-title">Vizion<span class="dot">.</span>Blog</a>

        <div class="menu-links">
            <a href="/licence/" aria-current={actif === 'licence' ? 'page' : undefined}>Licence</a>
            <a href="/autodidacte/" aria-current={actif === 'autodidacte' ? 'page' : undefined}>Autodidacte</a>
        </div>
    </div>
</nav>

<style>
    .navbar {
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border);
        padding: 1rem 0;
        margin-bottom: 2rem;
        position: sticky;
        top: 0;
        z-index: 10;
        backdrop-filter: blur(8px);
    }

    .nav-content {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .site-title {
        font-family: var(--font-mono);
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: -0.02em;
    }
    .site-title .dot {
        color: var(--accent);
    }

    .menu-links {
        display: flex;
        gap: 1.75rem;
        flex-wrap: wrap;
    }

    .menu-links a {
        text-decoration: none;
        color: var(--text-secondary);
        font-size: 1rem;
        font-weight: 500;
        padding: 0.15rem 0;
        border-bottom: 2px solid transparent;
        transition: color 0.2s ease, border-color 0.2s ease;
    }

    .menu-links a:hover {
        color: var(--accent);
    }

    .menu-links a[aria-current='page'] {
        color: var(--text-primary);
        border-bottom-color: var(--accent);
    }
</style>
